function wdEnsureServerTransferConfirmStyles(){if(document.getElementById("wd-server-transfer-confirm-styles"))return;const n=document.createElement("style");n.id="wd-server-transfer-confirm-styles",n.textContent=`
.wd-transfer-confirm-mask{position:fixed;inset:0;z-index:10050;display:flex;align-items:center;justify-content:center;padding:20px;background:rgba(15,23,42,.58);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);animation:wdTransferMaskIn .18s ease-out}
.wd-transfer-confirm-card{position:relative;width:min(420px,100%);overflow:hidden;border:1px solid rgba(147,197,253,.62);border-radius:24px;background:linear-gradient(180deg,#f8fbff 0%,#fff 48%);box-shadow:0 24px 70px rgba(15,23,42,.28);animation:wdTransferCardIn .22s cubic-bezier(.22,.8,.24,1)}
.wd-transfer-confirm-head{padding:28px 26px 18px;text-align:center;background:radial-gradient(circle at 50% -30%,rgba(96,165,250,.32),transparent 68%)}
.wd-transfer-confirm-icon{display:grid;place-items:center;width:54px;height:54px;margin:0 auto 12px;border-radius:17px;color:#fff;font-size:28px;font-weight:800;background:linear-gradient(135deg,#2563eb,#38bdf8);box-shadow:0 10px 25px rgba(37,99,235,.3)}
.wd-transfer-confirm-title{margin:0;color:#0f2d62;font-size:21px;font-weight:800;letter-spacing:.02em}
.wd-transfer-confirm-subtitle{margin:7px 0 0;color:#64748b;font-size:13px}
.wd-transfer-confirm-close{position:absolute;top:14px;right:14px;width:34px;height:34px;border:0;border-radius:50%;color:#64748b;background:rgba(255,255,255,.78);font-size:24px;line-height:1;cursor:pointer}
.wd-transfer-confirm-close:hover{color:#1e40af;background:#fff}
.wd-transfer-confirm-body{padding:4px 24px 24px}
.wd-transfer-route{display:grid;grid-template-columns:minmax(0,1fr) 34px minmax(0,1fr);align-items:center;gap:8px;padding:16px;border:1px solid #dbeafe;border-radius:18px;background:#f8fbff}
.wd-transfer-route-item{min-width:0;text-align:center}.wd-transfer-route-label{display:block;margin-bottom:5px;color:#94a3b8;font-size:12px}.wd-transfer-route-value{display:block;overflow:hidden;color:#173b75;font-size:15px;font-weight:800;text-overflow:ellipsis;white-space:nowrap}
.wd-transfer-route-arrow{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;color:#2563eb;background:#dbeafe;font-size:19px;font-weight:800}
.wd-transfer-role-count{display:flex;align-items:center;justify-content:space-between;margin-top:12px;padding:11px 14px;border-radius:13px;color:#365278;background:#eff6ff;font-size:13px}.wd-transfer-role-count strong{color:#1d4ed8;font-size:15px}
.wd-transfer-warning{display:flex;gap:10px;margin-top:12px;padding:13px 14px;border:1px solid #fed7aa;border-radius:14px;color:#9a3412;background:#fff7ed}.wd-transfer-warning-mark{flex:0 0 auto;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;color:#fff;background:#f97316;font-weight:800}.wd-transfer-warning strong,.wd-transfer-warning span{display:block}.wd-transfer-warning strong{margin:1px 0 3px;font-size:14px}.wd-transfer-warning span{color:#b45309;font-size:12px;line-height:1.55}
.wd-transfer-confirm-actions{display:grid;grid-template-columns:1fr 1.2fr;gap:10px;margin-top:18px}.wd-transfer-confirm-actions button{height:44px;border-radius:13px;font-size:15px;font-weight:700;cursor:pointer}.wd-transfer-confirm-cancel{border:1px solid #cbd5e1;color:#475569;background:#fff}.wd-transfer-confirm-submit{border:0;color:#fff;background:linear-gradient(135deg,#2563eb,#0ea5e9);box-shadow:0 9px 20px rgba(37,99,235,.24)}
@keyframes wdTransferMaskIn{from{opacity:0}to{opacity:1}}@keyframes wdTransferCardIn{from{opacity:0;transform:translateY(12px) scale(.97)}to{opacity:1;transform:translateY(0) scale(1)}}
@media(max-width:480px){.wd-transfer-confirm-mask{align-items:flex-end;padding:12px}.wd-transfer-confirm-card{border-radius:22px}.wd-transfer-confirm-head{padding-top:24px}.wd-transfer-confirm-body{padding:2px 18px 20px}}
